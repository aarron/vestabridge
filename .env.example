# --- Meshtastic / Heltec ----------------------------------------------------
# USB serial device for the Heltec node. Find it with: ls -l /dev/serial/by-id
HELTEC_SERIAL_PORT=/dev/ttyUSB0
# Which received mesh messages reach the board.
#   MESH_CHANNELS: comma-separated channel names to relay; "*" or empty = all.
#   MESH_RELAY_DIRECT: also relay direct messages addressed to this node.
MESH_CHANNELS=MyChannel
MESH_RELAY_DIRECT=true

# --- Vestaboard Local API ---------------------------------------------------
# The Vestaboard's IP on your LAN (set a DHCP reservation so it doesn't change).
VESTABOARD_LOCAL_IP=192.168.1.50
# The Local API key returned by the enablement step (see README).
VESTABOARD_API_TOKEN=
# Local API port (default 7000) and HTTP timeout in seconds.
VESTABOARD_PORT=7000
VESTABOARD_TIMEOUT=10

# --- Twilio -----------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Port the Flask/gunicorn webhook listens on locally.
FLASK_PORT=5000
# The public URL Twilio posts to (your Cloudflare Tunnel hostname + /sms).
# Must match the webhook URL configured in the Twilio console exactly, or
# signature validation will reject requests. Leave blank to auto-detect.
TWILIO_WEBHOOK_URL=https://sms.example.com/sms

# --- Logging ----------------------------------------------------------------
LOG_DIR=/var/log/vestabridge
LOG_LEVEL=INFO
